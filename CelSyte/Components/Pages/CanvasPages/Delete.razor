@page "/canvas/delete"
@using Microsoft.EntityFrameworkCore
@using CelSyte.Models
@inject IDbContextFactory<CelSyte.Data.CelSyteContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Canvas</h2>
    <hr />
    @if (canvas is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@canvas.Name</dd>
        </dl>
        <EditForm method="post" Model="canvas" OnValidSubmit="DeleteCanvas" FormName="delete" Enhance>
            <button type="submit" class="btn formbutton" disabled="@(canvas is null)">Delete</button> |
            <a class="linkcol" href="/canvas">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Canvas? canvas;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        canvas = await context.Canvas.FirstOrDefaultAsync(m => m.Id == Id);

        if (canvas is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteCanvas()
    {
        using var context = DbFactory.CreateDbContext();
        context.Canvas.Remove(canvas!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/canvas");
    }
}
