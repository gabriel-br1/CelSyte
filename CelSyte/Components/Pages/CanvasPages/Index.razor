@page "/canvas"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using CelSyte.Models
@using CelSyte.Data
@implements IAsyncDisposable
@inject IDbContextFactory<CelSyte.Data.CelSyteContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a class="linkcol" href="canvas/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.Canvas">
    <PropertyColumn Property="canvas => canvas.Name" />

    <TemplateColumn Context="canvas">
        <a class="linkcol" href="@($"canvas/edit?id={canvas.Id}")">Edit</a> |
        <a class="linkcol" href="@($"canvas/details?id={canvas.Id}")">Details</a> |
        <a class="linkcol" href="@($"canvas/delete?id={canvas.Id}")">Delete</a> |
        <a class="linkcol" href="@($"canvas/use?id={canvas.Id}")">Use</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private CelSyteContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
